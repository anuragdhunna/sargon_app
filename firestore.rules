# Sargon App - Security Rules

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin';
    }
    
    function isOwner(hotelId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' &&
        hotelId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hotelIds
      );
    }
    
    function hasHotelAccess(hotelId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        hotelId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hotelIds
      );
    }

    // User Profiles
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isSuperAdmin();
      allow write: if isSuperAdmin();
      // Owners can create staff for their hotels as per app logic, but restrict here
      allow update: if request.auth.uid == userId;
    }

    // Hotels
    match /hotels/{hotelId} {
      allow read: if hasHotelAccess(hotelId);
      allow write: if isSuperAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || isOwner(resource.data.hotelId);
      allow create: if isSignedIn(); // Auditing is performed by services
      allow update, delete: if false; // Audit logs are immutable
    }

    // Inventory, Orders, etc. (Tenant Isolated)
    match /{path=**}/inventory/{itemId} {
      allow read, write: if hasHotelAccess(resource.data.hotelId);
    }
    
    match /{path=**}/orders/{orderId} {
      allow read, write: if hasHotelAccess(resource.data.hotelId);
    }

    // Fallback for sub-collections within a hotel
    match /hotels/{hotelId}/{document=**} {
      allow read, write: if hasHotelAccess(hotelId);
    }
  }
}
